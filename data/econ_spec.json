    {
      "id": "claims", "match": "실업수당 청구", "period": "weekly",
      "metrics": [
        {"id": "initial",    "label": "신규 청구", "unit": "K", "primary": true, "fred": {"series": "ICSA", "units": "lin", "scale": 0.001, "tol_pct": 0.5}},
        {"id": "continuing", "label": "연속 청구", "unit": "K",                  "fred": {"series": "CCSA", "units": "lin", "scale": 0.001, "tol_pct": 0.5}}
