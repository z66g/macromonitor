        {"id": "core_yoy", "label": "근원 PCE YoY", "unit": "%", "primary": true, "fred": {"series": "PCEPILFE", "units": "pc1", "tol": 0.1}},
        {"id": "core_mom", "label": "근원 PCE MoM", "unit": "%",                  "fred": {"series": "PCEPILFE", "units": "pch", "tol": 0.1}},
        {"id": "yoy",      "label": "PCE YoY",      "unit": "%",                  "fred": {"series": "PCEPI",    "units": "pc1", "tol": 0.1}}
      ]
    },
    {
      "id": "jolts", "match": "구인이직보고서 (JOLTS)", "period": "monthly",
